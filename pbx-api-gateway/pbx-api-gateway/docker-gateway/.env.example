# ---- network ---------------------------------------------------------------
# This gateway host (the machine running Docker)
GW_LAN_IP=192.168.8.100
# Your Incredible PBX / FreePBX 17 server
GW_PBX_IP=192.168.8.220
# PBX side: transport-apiusers port (matches the module setting)
GW_PBX_PORT=5099
# NAT-style VPN (AstroWarp): phones connect to <virtual IP>:5070
GW_VPN_PORT=5070
# LAN, Tailscale subnet route, routed WireGuard: phones connect to GW_LAN_IP:5072
GW_LAN_PORT=5072
# Kamailio <-> PBX only
GW_PBX_SIDE_PORT=5071
# ONLY for NAT-style VPNs (GL.iNet AstroWarp): the virtual IP the VPN assigns to
# this gateway host. Phones then use <virtual IP>:5070.
# Tailscale subnet routers / routed WireGuard reach the real LAN IP: leave this EMPTY
# and have phones use GW_LAN_IP:5072. Must be a plain IPv4 address (no placeholders).
GW_VPN_ADVERTISE_IP=
# OPTIONAL public door (no VPN) for users with "Allow without VPN" ticked on the PBX page.
# Leave EMPTY to keep the door closed. Otherwise one of:
#   auto               find your public IP by itself (recommended if your IP can change)
#   phone.example.com  a name that points at your home (e.g. the Cloudflare updater below)
#   203.0.113.7        a fixed IP that never changes
# With "auto" or a name, kamailio + rtpengine check every GW_PUBLIC_IP_CHECK seconds and restart
# themselves when the IP changes, so phones keep working without you doing anything.
# Router: forward UDP GW_PUB_PORT and UDP GW_RTP_MIN-GW_RTP_MAX to GW_LAN_IP. Nothing else.
GW_PUBLIC_IP=
GW_PUBLIC_IP_CHECK=60
GW_PUB_PORT=5080
GW_RTP_MIN=40000
GW_RTP_MAX=40100

# ---- Cloudflare dynamic DNS (optional, container "ddns") --------------------
# Gives phones a name like phone.example.com that always points at your home IP.
# Cloudflare > My Profile > API Tokens > Create Token > template "Edit zone DNS" >
# Zone Resources: Include - Specific zone - your domain. Paste the token here.
# The record is kept DNS only (grey cloud): the orange proxy can't carry phone calls.
# Leave CF_API_TOKEN empty to keep this off. See docs/cloudflare-ddns.md.
CF_API_TOKEN=
CF_RECORD=
# Only if the log says it can't find the zone (Cloudflare > your domain > Overview > Zone ID)
CF_ZONE_ID=
DDNS_INTERVAL=300
CF_TTL=60
# ZOIPER-PRO-TODO: GW_PUBLIC_HOST=pbx.yourdomain.com and GW_TLS_PORT=5443

# ---- remote panel ----------------------------------------------------------
PBX_SSH_HOST=192.168.8.220
PBX_SSH_USER=apiremote
# Copy from the PBX: Applications -> API Users -> Settings -> Remote token
PBX_REMOTE_TOKEN=
# setup-docker.sh fills this in
PANEL_SECRET_KEY=
# Only NPM may talk to the panel
PANEL_TRUSTED_PROXY=192.168.8.147
PANEL_AUTH_HEADER=X-authentik-username
# Optional: comma-separated Authentik usernames allowed in
PANEL_ALLOWED_USERS=
PANEL_COOKIE_SECURE=1

# ---- User portal (optional, container "portal" on port 8010) --------------------
# Token from the PBX page: Settings > User portal. Turn the portal on there too.
PORTAL_TOKEN=
PORTAL_SECRET_KEY=change-me-to-a-long-random-string
PORTAL_SSH_USER=apiportal
# Only NPM may talk to the portal; the Authentik header names the person.
PORTAL_TRUSTED_PROXY=192.168.8.147
PORTAL_AUTH_HEADER=X-authentik-username
PORTAL_COOKIE_SECURE=1
PORTAL_SITE_NAME=Home phone
